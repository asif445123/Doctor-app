MONGO_URI=mongodb://localhost:27017/doctor_app
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Gmail SMTP (use an App Password, not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_gmail_app_password

# First admin bootstrap (optional - see README)
ADMIN_BOOTSTRAP_EMAIL=admin@doctor.com
ADMIN_BOOTSTRAP_PASSWORD=213170